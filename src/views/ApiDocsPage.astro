---
import CodeBlock from '@/components/molecules/CodeBlock.vue'
import { pillToneVars, METHOD_SEED } from '@/config/palette'
import activeEntriesQuery from '../../public/queries/active-cn-entries.rq?raw'
import entitiesByTypeQuery from '../../public/queries/entities-by-type.rq?raw'

const publicBase = import.meta.env.BASE_URL

const baseUrl = 'https://www.ammitto.org/api/v1'

// Every path below is taken from the catalogue the producer publishes at
// /index.jsonld. Response shapes follow those files; the catalogue example
// is illustrative, while the other samples retain their dated readings.
// The page used to list two endpoints against a base URL that redirects,
// with a @context we do not emit and counts from a corpus a seventh the
// size of today's. Start from the catalogue when this needs updating.
//
// The catalogue response below is illustrative, including its repeated-hex
// commit and digest. Resolve real bulk URLs from the live catalogue.
// Apart from that illustrative catalogue, sample sizes, counts and timestamps
// are dated readings, not live values. They were read on 2026-09-14 from
// /stats.json, /facets/types.json and
// /ontology/classes.jsonld, and every harmonize run moves them, so a
// mismatch against the deployed API is this page going stale rather than
// the producer changing shape. No test checks these against the live
// API: tests/apiDocsAccuracy.test.js reads source text only and says so.
const endpoints = [
  {
    method: 'GET',
    path: '/index.jsonld',
    description:
      'Catalogue of everything a run published: each file with its media type and byte size, each collection with its members. Start here rather than guessing a path.',
    example: `curl ${baseUrl}/index.jsonld`,
    response: `{
  "@context": "https://ammitto.org/api/v1/context.jsonld",
  "@type": "Index",
  "slice": "catalogue",
  "generated": "2026-10-21T12:00:00Z",
  "bulkRelease": {
    "tag": "api-v1-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "url": "https://github.com/ammitto/data/releases/tag/api-v1-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "published": "2026-10-20T10:00:00Z"
  },
  "entries": [
    {
      "name": "all.jsonld",
      "url": "https://github.com/ammitto/data/releases/download/api-v1-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/all.jsonld",
      "mediaType": "application/ld+json",
      "description": "Every node in one graph",
      "bytes": 156423069,
      "published": "2026-10-20T10:00:00Z",
      "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
      "releaseTag": "api-v1-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "sourceCommit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "name": "sources",
      "url": "sources",
      "description": "One aggregate per source",
      "members": ["au.jsonld", "ca.jsonld", "ch.jsonld", "..."]
    }
  ]
}`
  },
  {
    method: 'GET',
    path: '/stats.json',
    description: 'Entity and entry counts per source, and the totals. About 1 KB — read this rather than counting a larger file.',
    example: `curl ${baseUrl}/stats.json`,
    response: `{
  "generated_at": "2026-09-14T11:54:44Z",
  "sources": {
    "eu": { "entities": 6329, "entries": 6329 },
    "us": { "entities": 19410, "entries": 19410 },
    "uk": { "entities": 6355, "entries": 6355 }
  },
  "total_entities": 61332,
  "total_entries": 61332,
  "total_regimes": 179
}`
  },
  {
    method: 'GET',
    path: '/sources/{source}.jsonld',
    description: 'Every entity and entry from one source, as JSON-LD. The catalogue lists the sources available in the current publication.',
    example: `curl ${baseUrl}/sources/eu.jsonld`,
    response: `{
  "@context": "https://ammitto.org/api/v1/context.jsonld",
  "@graph": [
    {
      "@id": "https://www.ammitto.org/entity/eu/13",
      "@type": "PersonEntity",
      "entityType": "person",
      "names": [
        { "@type": "NameVariant", "fullName": "…", "script": "Latn", "isPrimary": true }
      ]
    }
  ]
}`
  },
  {
    method: 'GET',
    path: '/node/entity/{source}/{id}.jsonld',
    description: 'One entity on its own. Cheaper than the source aggregate when you already know the identifier; /node/entity/index.jsonld lists them.',
    example: `curl ${baseUrl}/node/entity/au/100.jsonld`,
    response: `{
  "@id": "https://www.ammitto.org/entity/au/100",
  "@type": "PersonEntity",
  "entityType": "person",
  "names": [
    { "@type": "NameVariant", "fullName": "Nazir Mohammad Abdul Basir", "script": "Latn", "isPrimary": true },
    { "@type": "NameVariant", "fullName": "Nazar Mohammad", "script": "Latn", "isPrimary": false }
  ]
}`
  },
  {
    method: 'GET',
    path: 'Bulk downloads via /index.jsonld',
    description:
      'Whole graph exports in JSON-LD or RDF/Turtle. Discover their immutable GitHub Release URLs in the catalogue and follow redirects. Check each entry’s size, digest and published date; the bulk release can differ from the searchable site snapshot. Prefer a source aggregate or a node document when you only need part of the graph.',
    example: `curl --fail ${baseUrl}/index.jsonld > catalogue.json
curl --fail --location "$(jq -r '.entries[] | select(.name == "all.jsonld") | .url' catalogue.json)" -o all.jsonld`,
    response: `{
  "@context": "https://ammitto.org/api/v1/context.jsonld",
  "@graph": [ /* every entity, entry, regime, authority and instrument */ ]
}`
  },
  {
    method: 'GET',
    path: '/ontology/classes.jsonld',
    description:
      'The published vocabulary, with properties.jsonld and hierarchy.json beside it. context.jsonld at the root maps the terms every document above uses.',
    example: `curl ${baseUrl}/ontology/classes.jsonld`,
    response: `{
  "@context": "https://ammitto.org/api/v1/context.jsonld",
  "@graph": [
    {
      "@id": "https://www.ammitto.org/ontology/Entity",
      "@type": "rdfs:Class",
      "label": "Entity",
      "comment": "Base class for all sanctionable entities"
    }
  ]
}`
  },
  {
    method: 'GET',
    path: '/facets/{facet}.json',
    description: 'Value lists for filtering — types, authorities, regimes, list types, countries, statuses — each with a count.',
    example: `curl ${baseUrl}/facets/types.json`,
    response: `{
  "facets": [
    { "code": "person", "name": "Person", "icon": "user", "count": 31318 },
    { "code": "organization", "name": "Organization", "icon": "building", "count": 26946 },
    { "code": "vessel", "name": "Vessel", "icon": "ship", "count": 2726 },
    { "code": "aircraft", "name": "Aircraft", "icon": "plane", "count": 342 }
  ]
}`
  },

  {
    method: 'GET',
    path: '/search-index/manifest.json',
    description: 'Discover source shards for client-side search. Each file is relative to search-index/. The former search-index.json download has been replaced.',
    example: `curl --fail ${baseUrl}/search-index/manifest.json`,
    response: `{
  "metadata": { "generated": "2026-10-14T10:35:08Z", "totalEntities": 61578, "sources": 14 },
  "shards": [ { "code": "cn", "file": "cn.json", "count": 323 } ]
}`
  },
  {
    method: 'GET',
    path: '/search-index/{source}.json',
    description: 'A compact entities array for one source; select the file from the manifest. Its metadata describes only this shard. names are strings here, unlike NameVariant objects in full entity nodes.',
    example: `curl --fail ${baseUrl}/search-index/cn.json`,
    response: `{
  "metadata": { "generated": "2026-10-14T10:35:08Z", "totalEntities": 323, "sources": 1 },
  "entities": [ { "id": "https://www.ammitto.org/entity/cn/202510-dedrone-by-axon", "ref": "cn/202510-dedrone-by-axon", "type": "organization", "names": ["Dedrone by Axon", "反无人机技术公司"], "primaryName": "Dedrone by Axon", "authority": "cn", "status": "active" } ]
}`
  },
  {
    method: 'GET',
    path: '/by-authority/{code}.jsonld',
    description: 'Sanction-entry references, not full entities. Discover codes at by-authority/index.jsonld. by-regime, by-status and by-list work similarly; by-type contains entity references.',
    example: `curl --fail ${baseUrl}/by-authority/cn.jsonld`,
    response: `{
  "@context": "https://ammitto.org/api/v1/context.jsonld",
  "@type": "Index",
  "slice": "by-authority",
  "authority": { "@id": "https://www.ammitto.org/authority/cn" },
  "entries": [ { "@id": "https://www.ammitto.org/entry/cn/unreliable-entity-list/202510-dedrone-by-axon" } ]
}`
  },
  {
    method: 'GET',
    path: '/node/entry/{source}/{list}/{id}.jsonld',
    description: 'A sanction entry links entityId to its entity and carries authority, regime and status. Discover exact paths in node/entry/index.jsonld; entry identifiers can contain further path segments.',
    example: `curl --fail ${baseUrl}/node/entry/cn/unreliable-entity-list/202510-dedrone-by-axon.jsonld`,
    response: `{
  "@id": "https://www.ammitto.org/entry/cn/unreliable-entity-list/202510-dedrone-by-axon",
  "@type": "SanctionEntry",
  "entityId": "https://www.ammitto.org/entity/cn/202510-dedrone-by-axon",
  "authority": { "@id": "https://www.ammitto.org/authority/cn" },
  "status": "active"
}`
  },
]

const codeExamples = {
  javascript: `// Ask the catalogue what exists before fetching anything
const index = await (await fetch('${baseUrl}/index.jsonld')).json();
for (const entry of index.entries) {
  console.log(entry.name, entry.bytes ?? \`\${entry.members?.length ?? 0} members\`);
}

// Then take one source
const data = await (await fetch('${baseUrl}/sources/eu.jsonld')).json();

// The graph holds entity AND sanction-entry nodes; entries carry no names
for (const node of data['@graph']) {
  if (!node['@id'].includes('/entity/')) continue;
  console.log(node.names?.[0]?.fullName);
}`,
  search: `// Filter a downloaded shard; this is a local substring query, not FlexSearch.
async function getJson(path) {
  const response = await fetch('${baseUrl}/' + path);
  if (!response.ok) throw new Error('HTTP ' + response.status + ': ' + path);
  return response.json();
}
const manifest = await getJson('search-index/manifest.json');
const shard = manifest.shards.find(s => s.code === 'cn');
if (!shard) throw new Error('CN is not in this publication');
const data = await getJson('search-index/' + shard.file);
const query = 'dedrone';
const matches = data.entities.filter(entity =>
  entity.status === 'active' &&
  entity.names.some(name => name.toLowerCase().includes(query.toLowerCase()))
);
console.log(matches.map(entity => entity.ref));`,
  entries: `// Resolve a slice reference to its entry, then to its entity.
// Uses getJson from the preceding example.
function nodePath(iri) {
  const url = new URL(iri);
  if (url.origin !== 'https://www.ammitto.org') throw new Error('Unexpected IRI');
  return 'node' + url.pathname + '.jsonld';
}
const slice = await getJson('by-authority/cn.jsonld');
const first = slice.entries[0];
if (first) {
  const entry = await getJson(nodePath(first['@id']));
  const entity = await getJson(nodePath(entry.entityId));
  console.log(entry.status, entity.names.find(n => n.isPrimary)?.fullName);
}`,
  ruby: `require 'net/http'
require 'json'

stats = JSON.parse(Net::HTTP.get(URI('${baseUrl}/stats.json')))

# The totals are top-level keys, not nested under "totals"
puts "Entities: #{stats['total_entities']} across #{stats['sources'].size} sources"

stats['sources'].each { |code, c| puts "  #{code}: #{c['entities']}" }`,
  python: `import requests

BASE = '${baseUrl}'

# One entity, by identifier — far cheaper than the source aggregate
node = requests.get(f'{BASE}/node/entity/au/100.jsonld').json()
print(node['@type'], node['names'][0]['fullName'])

# Or a whole source
data = requests.get(f'{BASE}/sources/eu.jsonld').json()
for n in data['@graph']:
    if '/entity/' not in n['@id']:
        continue
    for name in n.get('names', [])[:1]:
        if name.get('fullName'):
            print(name['fullName'])`,
}
---
<div class="docs-page min-h-screen">
    <div class="container-wide py-12">
      <nav aria-label="Developer documentation" class="mb-7 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a href="/api" aria-current="page" class="text-brand-link underline underline-offset-4">API</a>
        <a href="/schema" class="text-brand-link underline underline-offset-4">Data schema</a>
        <a href="/ontology" class="text-brand-link underline underline-offset-4">Ontology</a>
        <a href="/ruby" class="text-brand-link underline underline-offset-4">Ruby gem</a>
        <a href="/download" class="text-brand-link underline underline-offset-4">Downloads</a>
      </nav>
      <h1 class="text-4xl font-bold mb-4 text-light-text dark:text-dark-text">
        API Documentation
      </h1>
      <p class="text-light-muted dark:text-dark-muted mb-8 max-w-3xl">
        Download sanctions data as static, read-only files. No API key required. Search and filtering run in your client; these URLs do not accept search or pagination parameters.
      </p>
      <p class="text-light-muted dark:text-dark-muted mb-8">
        Prefer a direct file download?{' '}
        <a href="/download" class="text-brand-link underline">
          {' '}Download the published datasets{' '}
        </a>.
      </p>

      <nav aria-label="On this page" class="mb-10 border-y border-light-border dark:border-dark-border py-4">
        <p class="mb-2 text-sm font-semibold text-light-text dark:text-dark-text">On this page</p>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
          <li><a href="#base-url" class="text-brand-link underline underline-offset-4">Base URL</a></li>
          <li><a href="#contract-heading" class="text-brand-link underline underline-offset-4">OpenAPI contract</a></li>
          <li><a href="#endpoints" class="text-brand-link underline underline-offset-4">Endpoints</a></li>
          <li><a href="#code-examples" class="text-brand-link underline underline-offset-4">Code Examples</a></li>
          <li><a href="#sparql-heading" class="text-brand-link underline underline-offset-4">SPARQL: query a local dataset</a></li>
          <li><a href="#caching" class="text-brand-link underline underline-offset-4">Caching and bulk access</a></li>
        </ul>
      </nav>

      <section class="mb-12">
        <h2 id="base-url" class="text-2xl font-semibold mb-4 text-light-text dark:text-dark-text">
          Base URL
        </h2>
        <CodeBlock client:load
          code={baseUrl}
          title="Base URL"
        />
      </section>

      <section class="mb-12" aria-labelledby="contract-heading">
        <h2 id="contract-heading" class="text-2xl font-semibold mb-4 text-light-text dark:text-dark-text">OpenAPI contract</h2>
        <p class="text-light-muted dark:text-dark-muted">
          <a href={`${publicBase}openapi.json`} download class="text-brand-link underline">Download OpenAPI 3.1 (JSON)</a>{' '}
          for the static file API. File suffixes are required. Available identifiers come from the catalogue and collection indexes;
          legal instruments use <code>node/legal-instrument/</code>. Snapshot values below are illustrative excerpts, not live totals.
        </p>
      </section>

      <section class="mb-12">
        <h2 id="endpoints" class="text-2xl font-semibold mb-4 text-light-text dark:text-dark-text">
          Endpoints
        </h2>
        <div class="space-y-6">
          {endpoints.map((endpoint) => (<div   class="glass-card p-6">
            <!-- flex-wrap + break-all: endpoint paths are unbreakable strings
                 and pushed the page past a 320px viewport. -->
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <!-- Was bg-green-500/20 text-green-600: green on green, 2.74:1
                   in light and 3.73:1 in dark. The method chip now takes the
                   same per-theme tone derivation as the badges. -->
              <span
                class="tone-pill px-2 py-1 rounded-sm text-xs font-bold"
                style={pillToneVars(METHOD_SEED)}
              >
                {endpoint.method}
              </span>
              <code class="font-mono break-all text-light-text dark:text-dark-text">{endpoint.path}</code>
            </div>
            <p class="text-light-muted dark:text-dark-muted mb-4">
              {endpoint.description}
            </p>
            <CodeBlock client:load
              code={endpoint.example}
              language="bash"
              title={`Request: ${endpoint.path}`}
            />
            <div class="mt-4">
              <CodeBlock client:load
                code={endpoint.response}
                language="json"
                title={`Response excerpt: ${endpoint.path} (values vary by publication)`}
              />
            </div>
          </div>))}
        </div>
      </section>

      <section class="mb-12">
        <h2 id="code-examples" class="text-2xl font-semibold mb-4 text-light-text dark:text-dark-text">
          Code Examples
        </h2>

        <div class="space-y-6">
          <div>
            <h3 class="text-lg font-medium mb-3 text-light-text dark:text-dark-text">JavaScript</h3>
            <CodeBlock client:load code={codeExamples.javascript} title="JavaScript catalogue example" language="javascript" />
          </div>

          <div>
            <h3 class="text-lg font-medium mb-3 text-light-text dark:text-dark-text">Search one source locally</h3>
            <CodeBlock client:load code={codeExamples.search} title="Search one source locally" language="javascript" />
          </div>
          <div>
            <h3 class="text-lg font-medium mb-3 text-light-text dark:text-dark-text">Follow a sanction-entry reference</h3>
            <CodeBlock client:load code={codeExamples.entries} title="Follow a sanction-entry reference" language="javascript" />
          </div>
          <div>
            <h3 class="text-lg font-medium mb-3 text-light-text dark:text-dark-text">Ruby</h3>
            <CodeBlock client:load code={codeExamples.ruby} title="Ruby client example" language="ruby" />
          </div>

          <div>
            <h3 class="text-lg font-medium mb-3 text-light-text dark:text-dark-text">Python</h3>
            <CodeBlock client:load code={codeExamples.python} title="Python client example" language="python" />
          </div>
        </div>
      </section>

      <section class="mb-12" aria-labelledby="sparql-heading">
        <h2 id="sparql-heading" class="text-2xl font-semibold mb-4 text-light-text dark:text-dark-text">SPARQL: query a local dataset</h2>
        <p class="text-light-muted dark:text-dark-muted mb-4">
          Ammitto publishes Turtle downloads; it currently has no hosted SPARQL endpoint.
          Load <code>sources/cn.ttl</code> or <code>all.ttl</code> into your own RDF tool or SPARQL store.
          The queries use the default graph and the Turtle exporter’s ontology predicates.
          An entity’s names are blank nodes reached through <code>ammitto:hasName</code>.
        </p>
        <p class="text-light-muted dark:text-dark-muted mb-4">
          With Ruby and the <code>rdf-turtle</code> and <code>sparql</code> gems already available, download a source and run the query locally:
        </p>
        <CodeBlock client:load code={`curl --fail --location --compressed ${baseUrl}/sources/cn.ttl -o cn.ttl
curl --fail --location https://www.ammitto.org/queries/active-cn-entries.rq -o active-cn-entries.rq
sparql execute --dataset cn.ttl --format json active-cn-entries.rq`} title="Download and query CN data locally" language="bash" />
        <h3 class="text-lg font-medium my-4 text-light-text dark:text-dark-text">Active CN entries with primary names</h3>
        <CodeBlock client:load code={activeEntriesQuery} title="Active CN entries with primary names" language="sparql" />
        <a href={`${publicBase}queries/active-cn-entries.rq`} download class="text-brand-link underline">Download active-entry query</a>
        <h3 class="text-lg font-medium my-4 text-light-text dark:text-dark-text">Count distinct entities by type</h3>
        <CodeBlock client:load code={entitiesByTypeQuery} title="Count distinct entities by type" language="sparql" />
        <a href={`${publicBase}queries/entities-by-type.rq`} download class="text-brand-link underline">Download entity-count query</a>
        <p class="text-light-muted dark:text-dark-muted mt-4">
          Counts cover only the loaded dataset. For a store you operate, import Turtle into its default graph and use its query interface.
          A named-graph import needs <code>GRAPH &lt;your-import-graph-iri&gt; &#123; ... &#125;</code> around the query patterns.
          Follow that store’s authentication and network setup instructions; the static API cannot execute SPARQL.
          See <a href="https://github.com/ammitto/ammitto.github.io/blob/main/docs/api.adoc" class="text-brand-link underline">the local and self-hosting guide</a> for details.
        </p>
      </section>

      <section class="mb-12">
        <h2 id="caching" class="text-2xl font-semibold mb-4 text-light-text dark:text-dark-text">
          Caching and bulk access
        </h2>
        <p class="text-light-muted dark:text-dark-muted">
          No service quota is specified here; hosting limits may apply. Cache snapshots and use compressed downloads. For repeated or high-volume queries, download the relevant data and query it locally.
        </p>
      </section>
    </div>
  </div>

<style>
/* The global 5rem scroll padding clears the header; add room at the heading. */
.docs-page h2[id] { scroll-margin-top: 1rem; }
.docs-page nav [aria-current="page"] { font-weight: 700; }
</style>
