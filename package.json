{
  "name": "ammitto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:api && node scripts/dev.js",
    "build": "npm run build:api && npm run typecheck && astro build && node scripts/build-search-runtime.mjs dist && node scripts/finalize-astro-build.mjs dist",
    "build:api": "node scripts/build-api-data.js",
    "preview": "astro preview",
    "typecheck": "astro check && vue-tsc --noEmit",
    "test:unit": "tsc -p tsconfig.test.json && node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "d3-force": "3.0.0",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "flexsearch": "^0.7.43",
    "vue": "^3.5.24",
    "astro": "^7.4.2",
    "@astrojs/vue": "^7.1.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/d3-force": "3.0.10",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/flexsearch": "^0.7.6",
    "@types/node": "^20.11.25",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.2",
    "vite": "^8.0.0",
    "vue-tsc": "^3.0.0",
    "yaml": "^2.3.4",
    "@tailwindcss/vite": "^4.0.0",
    "@astrojs/check": "^0.9.4"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
