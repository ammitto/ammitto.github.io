      "effects": [
        {
          "effect_type": "asset_freeze",
          "scope": "full",
          "description": [
            {
              "value": "冻结在我国境内的动产、不动产和其他各类财产",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Freeze all assets in China, including movable and immovable property and other types of assets",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "prohibit_transactions",
          "scope": "full",
          "description": [
            {
              "value": "禁止我国境内的组织、个人与其本人进行有关交易、合作等活动",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "visa_ban",
          "scope": "full",
          "description": [
