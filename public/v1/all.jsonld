        "effective_date": "2025-04-10",
        "effective_time": "00:01",
        "is_indefinite": false
      },
      "status": "active",
      "reference_number": "202522-exovera",
      "announcement": {
        "title": "公布将12家美国实体列入出口管制管控名单",
        "url": "https://www.mofcom.gov.cn/zwgk/zcfb/art/2025/art_c6b190344a154e6f831e0fdfc190e41e.html",
        "published_date": "2025-04-09",
        "document_type": "商务部公告",
        "document_id": "2025年第22号",
        "signatory": "商务部",
        "authority": "中华人民共和国商务部",
        "content": "根据《中华人民共和国出口管制法》和《中华人民共和国两用物项出口管制条例》等法律法规有关规定，为维护国家安全和利益，履行防扩散等国际义务，决定将美国光子公司等12家美国实体列入出口管制管控名单（见附件），并采取以下措施：\n\n一、禁止向上述12家美国实体出口两用物项；正在开展的相关出口活动应当立即停止。\n二、特殊情况下确需出口的，出口经营者应当向商务部提出申请。\n\n本公告自2025年4月10日12时01分起正式实施。\n",
        "language": "zh-CN"
      },
      "group_id": "https://www.ammitto.org/group/cn/202522",
      "legal_citations": [
        {
          "legal_instrument_id": "https://www.ammitto.org/legal-instrument/cn/npc-export-control-law",
          "citation_type": "legal_basis"
        },
        {
          "legal_instrument_id": "https://www.ammitto.org/legal-instrument/cn/mofcom-dual-use-export-control-regulation",
          "citation_type": "legal_basis"
        }
      ],
      "raw_source_data": {
        "source_format": "yaml",
        "source_specific_fields": {
          "cn:list_type": "export_control",
          "cn:sanction_list": "出口管制管控名单",
          "cn:chinese_name": "埃克索维拉公司",
          "cn:english_name": "Exovera"
        }
      },
      "@context": "https://www.ammitto.org/ontology/context.jsonld"
    },
    {
      "id": "https://www.ammitto.org/entry/cn/import-export-control-list/202522-teledyne-brown-engineering-inc",
      "entity_id": "https://www.ammitto.org/entity/cn/202522-teledyne-brown-engineering-inc",
      "authority": {
        "@id": "https://www.ammitto.org/authority/cn"
      },
      "regime": {
        "@id": "https://www.ammitto.org/regime/cn_export_control"
      },
      "effects": [
        {
          "effect_type": "prohibit_export_dual_use_items",
          "scope": "full",
          "description": [
            {
              "value": "禁止向上述美国实体出口两用物项；正在开展的相关出口活动应当立即停止",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit the export of dual-use items to the above US entity; ongoing related export activities should be immediately ceased",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "export_license_requirement",
          "scope": "full",
          "description": [
            {
              "value": "特殊情况下确需出口的，出口经营者应当向商务部提出申请",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "In special circumstances where export is necessary, exporters should apply to the Ministry of Commerce for approval",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
            {
              "value": "为维护国家安全和利益，履行防扩散等国际义务",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "To safeguard national security and interests, and to fulfill international obligations such as non-proliferation",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
