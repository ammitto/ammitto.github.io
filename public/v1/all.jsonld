    {
      "id": "https://www.ammitto.org/entry/cn/anti-sanction-list/16-insitu-inc",
      "entity_id": "https://www.ammitto.org/entity/cn/16-insitu-inc",
      "authority": {
        "@id": "https://www.ammitto.org/authority/cn"
      },
      "regime": {
        "@id": "https://www.ammitto.org/regime/cn_anti_sanctions"
      },
      "effects": [
        {
          "effect_type": "asset_freeze",
          "scope": "full",
          "description": [
            {
              "value": "冻结在我国境内的动产、不动产和其他各类财产",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Freeze all assets in China, including movable and immovable property and other types of assets",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "prohibit_transactions",
          "scope": "full",
          "description": [
            {
              "value": "禁止我国境内的组织、个人与其进行有关交易、合作等活动",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
            {
              "value": "美国近日再次宣布向中国台湾地区提供大额武器援助并出售武器，美国\"2025财年国防授权法案\"包括多项涉华消极条款，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "The US recently announced providing large-scale weapons assistance and selling weapons to China's Taiwan region, and the US \"2025 National Defense Authorization Act\" includes multiple negative provisions related to China, seriously violating the One-China principle and the three China-US joint communiqués, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity.",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "period": {
        "effective_date": "2024-12-27",
        "is_indefinite": false
      },
      "status": "active",
      "reference_number": "16-insitu-inc",
      "announcement": {
        "title": "关于对美国军工企业及高级管理人员采取反制措施的决定",
        "url": "https://www.mfa.gov.cn/web/wjb_673085/zfxxgk_674865/gknrlb/fzcqdcs/202412/t20241227_11520050.shtml",
        "published_date": "2024-12-27",
        "published_time": "15:00",
        "document_type": "中华人民共和国外交部令",
        "document_id": "第16号",
        "signatory": "外交部",
        "authority": "中华人民共和国外交部",
        "content": "（2024年12月27日中华人民共和国外交部令第16号公布，自2024年12月27日起施行）\n\n美国近日再次宣布向中国台湾地区提供大额武器援助并出售武器，美国\"2025财年国防授权法案\"包括多项涉华消极条款，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。\n\n依据《中华人民共和国反外国制裁法》第三条、第四条、第五条、第六条、第九条、第十五条规定，中方决定对英斯图公司、哈德森技术公司、萨罗尼克科技公司、雷神加拿大公司、雷神澳大利亚公司、爱尔康公司、国际海洋工程公司等7家后附《反制清单》列明的企业及相关高级管理人员采取以下反制措施：\n\n一、冻结在我国境内的动产、不动产和其他各类财产；\n二、禁止我国境内的组织、个人与其进行有关交易、合作等活动。\n\n本决定自2024年12月27日起施行。\n",
        "language": "zh-CN"
      },
      "group_id": "https://www.ammitto.org/group/cn/16",
      "legal_citations": [
        {
          "legal_instrument_id": "https://www.ammitto.org/legal-instrument/cn/npc-anti-foreign-sanctions-law",
          "articles": [
            "第三条",
            "第四条",
            "第五条",
            "第六条",
            "第九条",
            "第十五条"
          ],
          "citation_type": "legal_basis"
        }
      ],
      "raw_source_data": {
        "source_format": "yaml",
        "source_specific_fields": {
          "cn:list_type": "anti_sanctions",
          "cn:sanction_list": "反制裁清单",
          "cn:chinese_name": "英斯图公司",
          "cn:english_name": "Insitu, Inc."
        }
      },
      "@context": "https://www.ammitto.org/ontology/context.jsonld"
    },
