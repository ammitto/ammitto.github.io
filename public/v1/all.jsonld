      "effects": [
        {
          "effect_type": "prohibit_export_dual_use_items",
          "scope": "full",
          "description": [
            {
              "value": "禁止向上述台湾地区实体出口两用物项；正在开展的相关出口活动应当立即停止",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit the export of dual-use items to the above Taiwan entity; ongoing related export activities should be immediately ceased",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "export_license_requirement",
          "scope": "full",
          "description": [
            {
              "value": "特殊情况下确需出口的，出口经营者应当向商务部提出申请",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "In special circumstances where export is necessary, exporters should apply to the Ministry of Commerce for approval",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
            {
              "value": "为维护国家安全和利益，履行防扩散等国际义务",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "To safeguard national security and interests, and to fulfill international obligations such as non-proliferation",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
