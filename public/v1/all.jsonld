            {
              "value": "Prohibit organizations and individuals in China from engaging in\ntransactions, cooperation, etc. with the entity, especially\ntransmitting data and providing sensitive information to the entity\n",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
