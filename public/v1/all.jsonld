          "cn:list_type": "anti_sanctions",
          "cn:sanction_list": "反制裁清单",
          "cn:chinese_name": "诺斯罗普·格鲁曼系统公司",
          "cn:english_name": "Northrop Grumman Systems Corporation"
        }
      },
