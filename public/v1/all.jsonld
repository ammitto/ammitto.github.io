              "value": "冻结在我国境内的动产、不动产和其他各类财产",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Freeze all assets in China, including movable and immovable property and other types of assets",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "prohibit_transactions",
          "scope": "full",
          "description": [
            {
              "value": "禁止我国境内的组织、个人与其本人进行有关交易、合作等活动",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "visa_ban",
          "scope": "full",
          "description": [
            {
              "value": "对其本人及其配偶、子女不予签发签证、不准入境",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Visa ban and entry prohibition for the individual and his spouse and children",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
            {
              "value": "近年来频繁采取干涉中国内政、损害中国主权安全发展利益的言行。",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Frequently engaged in actions interfering in China's internal affairs and damaging China's sovereignty, security and development interests.",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "period": {
