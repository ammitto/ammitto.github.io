          "cn:chinese_name": "麦克·加拉格尔",
          "cn:english_name": "Mike Gallagher"
        }
      },
      "@context": "https://www.ammitto.org/ontology/context.jsonld"
    },
    {
      "id": "https://www.ammitto.org/entry/cn/anti-sanction-list/7-lockheed-martin-missiles-and-fi",
