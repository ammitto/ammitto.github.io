      "authority": {
        "@id": "https://www.ammitto.org/authority/cn"
      },
      "regime": {
        "@id": "https://www.ammitto.org/regime/cn_anti_sanctions"
      },
      "effects": [
        {
          "effect_type": "asset_freeze",
          "scope": "full",
          "description": [
            {
              "value": "冻结在我国境内的动产、不动产和其他各类财产",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Freeze all assets in China, including movable and immovable property and other types of assets",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "prohibit_transactions",
          "scope": "full",
          "description": [
            {
              "value": "禁止我国境内的组织、个人与其进行有关交易、合作等活动",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
            {
              "value": "美国近日再次宣布向中国台湾地区提供大额武器援助并出售武器，美国\"2025财年国防授权法案\"包括多项涉华消极条款，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "The US recently announced providing large-scale weapons assistance and selling weapons to China's Taiwan region, and the US \"2025 National Defense Authorization Act\" includes multiple negative provisions related to China, seriously violating the One-China principle and the three China-US joint communiqués, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity.",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "period": {
        "effective_date": "2024-12-27",
        "is_indefinite": false
      },
