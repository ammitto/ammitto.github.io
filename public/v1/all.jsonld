      },
      "effects": [
        {
          "effect_type": "asset_freeze",
          "scope": "full",
          "description": [
            {
              "value": "冻结在我国境内的动产、不动产和其他各类财产",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Freeze all assets in China, including movable and immovable property and other types of assets",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "prohibit_transactions",
          "scope": "full",
          "description": [
            {
              "value": "禁止我国境内的组织、个人与其进行有关交易活动",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit transactions with Chinese organizations and individuals",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "entry_ban",
          "scope": "full",
          "description": [
            {
              "value": "对其本人及直系亲属不予签发签证、不准入境",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Visa ban for the individual and their immediate family members",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
            {
              "value": "美方借口所谓“西藏人权”问题，对两名中方官员进行非法制裁",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "The US imposed illegal sanctions on two Chinese officials under the pretext of \"Tibet human rights\" issues.",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
