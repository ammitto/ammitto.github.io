        "@id": "https://www.ammitto.org/authority/cn"
      },
      "regime": {
        "@id": "https://www.ammitto.org/regime/cn_anti_sanctions"
      },
      "effects": [
        {
          "effect_type": "asset_freeze",
          "scope": "full",
          "description": [
            {
              "value": "冻结在我国境内的动产、不动产和其他各类财产",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Freeze all assets in China, including movable and immovable property and other types of assets",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "prohibit_transactions",
          "scope": "full",
          "description": [
            {
              "value": "禁止我国境内的组织、个人与其本人进行有关交易、合作等活动",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Prohibit organizations and individuals in China from engaging in transactions, cooperation or related activities with the entity",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        },
        {
          "effect_type": "visa_ban",
          "scope": "full",
          "description": [
            {
              "value": "对其本人不予签发签证、不准入境（包括香港、澳门）",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Visa ban and entry prohibition (including Hong Kong and Macao)",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
            {
              "value": "美国近日宣布向中国台湾地区大规模出售武器，严重违反一个中国原则和中美三个联合公报，严重干涉中国内政，严重损害中国主权和领土完整。",
              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "The US recently announced large-scale arms sales to China's Taiwan region, seriously violating the One-China principle and the three China-US joint communiqués, seriously interfering in China's internal affairs, and seriously damaging China's sovereignty and territorial integrity.",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "period": {
