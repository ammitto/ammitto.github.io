              "lang": "zh",
              "script": "Hani",
              "is_primary": true
            },
            {
              "value": "Visa ban and entry prohibition (including Hong Kong and Macao)",
              "lang": "en",
              "script": "Latn",
              "is_primary": false
            }
          ]
        }
      ],
      "reasons": [
        {
          "category": "other",
          "description": [
