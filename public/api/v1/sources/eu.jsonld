    {
      "id": "https://www.ammitto.org/entity/eu/EU.13083.38",
      "entity_type": "organization",
      "names": [
        {
          "full_name": "Autonomous non-profit Organisation “Scientific and Production Center for Testing and Competence in the Field of Development of Unmanned Aircraft Systems and Means of Protection Against their Illegal Use ‘Ushkuynik’”",
          "script": "Latn",
          "is_primary": true
        },
        {
          "full_name": "Автономная Некоммерческая организация “Научно-Производственный Центр Испытаний и Компетенций в Сфере Развития Беспилотных Авиационных Систем и Средств Защиты От Их Противоправного Применения ‘Ушкуйник’”",
          "script": "Cyrl",
          "is_primary": false
        },
        {
          "full_name": "Scientific-Research Centre “Ushkuynik”",
          "script": "Latn",
          "is_primary": false
        },
        {
          "full_name": "АНО “НПЦ ‘Ушкуйник’”",
          "script": "Cyrl",
          "is_primary": false
        },
        {
          "full_name": "‚‚Ushkuynik’ – znanstveni i proizvodni centar za ispitivanje i stručnost u području razvoja sustava bespilotnih letjelica i sredstava zaštite od njihove nezakonite uporabe’",
          "script": "Latn",
          "is_primary": false
        },
        {
          "full_name": "»’Ushkuynik’ Tudományos és Gyártóközpont a Pilóta Nélküli  Légijármű-rendszerek és a Jogellenes  Használatuk Elleni Védelmet Szolgáló  Eszközök Teszteléséért és Kompetenciájáért« autonóm nonprofit szervezet",
          "script": "Latn",
          "is_primary": false
        },
        {
          "full_name": "»Ushkuynik« Tudományos Kutatóközpont",
          "script": "Latn",
          "is_primary": false
        },
        {
          "full_name": "Neovisna neprofitna organizacija ‚Scientific and Production Center for  Testing and Competence in the Field of  Development of Unmanned Aircraft Systems and Means of Protection Against their Illegal Use ‚Ushkuynik’’",
          "script": "Latn",
          "is_primary": false
        },
        {
          "full_name": "Organização autónoma sem fins lucrativos “Centro científico e de  produção para ensaios e competências  no domínio do desenvolvimento de  sistemas de aeronaves não tripuladas e meios de proteção contra a sua utilização ilegal ‘Ushkuynik’”",
          "script": "Latn",
          "is_primary": false
        },
        {
          "full_name": "„Научен и производствен център за  изпитване и компетентност в областта  на разработването на безпилотни  летателни системи и средства за защита срещу тяхното незаконно използване „Ушкуйник““",
          "script": "Cyrl",
          "is_primary": false
        }
