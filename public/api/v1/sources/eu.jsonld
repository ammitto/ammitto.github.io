      "legal_bases": [
        {
          "type": "amendment",
          "identifier": "2020/716 (OJ L168)",
          "title": "2020/716 (OJ L168)",
          "issuing_body": "Council",
          "issuance_date": "2020-05-29",
          "url": "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32020R0716&from=EN"
        }
      ],
      "effects": [
        {
          "effect_type": "asset_freeze",
          "scope": "full"
